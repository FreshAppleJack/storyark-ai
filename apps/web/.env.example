# Copy to apps/web/.env.local. All VITE_* values are public and built into JS.
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=10000
VITE_AI_TIMEOUT_MS=60000

# Development server only; these variables are not exposed to the browser.
STORYARK_WEB_HOST=0.0.0.0
STORYARK_WEB_PORT=3000
STORYARK_API_PROXY_TARGET=http://localhost:8080
