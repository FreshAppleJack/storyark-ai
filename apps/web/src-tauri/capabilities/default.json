{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local library commands for the main application window only.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-local-reorder-characters",
    "dialog:allow-save",
    "fs:allow-write-file",
    "allow-local-list-books", "allow-local-read-book", "allow-local-create-book",
    "allow-local-create-volume", "allow-local-create-chapter", "allow-local-save-chapter",
    "allow-local-rename", "allow-local-update-book", "allow-local-set-read-only", "allow-local-reorder", "allow-local-delete",
    "allow-local-list-characters", "allow-local-create-character", "allow-local-update-character",
    "allow-local-archive-character", "allow-local-backup",
    "allow-local-read-graph", "allow-local-initialize-graph", "allow-local-save-graph",
    "allow-local-read-preferences", "allow-local-save-preferences",
    "allow-local-read-brainstorm", "allow-local-save-brainstorm",
    "core:event:allow-listen",
    "allow-local-update-note", "allow-local-read-planning", "allow-local-save-planning",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:webview:allow-internal-toggle-devtools"
  ]
}
