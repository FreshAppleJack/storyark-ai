{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local library commands for the main application window only.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-local-list-books", "allow-local-read-book", "allow-local-create-book",
    "allow-local-create-volume", "allow-local-create-chapter", "allow-local-save-chapter",
    "allow-local-rename", "allow-local-set-read-only", "allow-local-reorder", "allow-local-delete",
    "allow-local-backup",
    "core:event:allow-listen",
    "core:window:allow-close",
    "core:window:allow-destroy"
  ]
}
