# Example values only. Set required variables through your local environment,
# IDE run configuration, deployment secret store, or an app-specific .env file.
# Never commit real credentials.

# Database
STORYARK_DB_URL=jdbc:mysql://localhost:3306/storyark?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false
STORYARK_DB_USERNAME=storyark_app
STORYARK_DB_PASSWORD=replace-with-local-secret

# AI provider
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_API_KEY=replace-with-provider-key
DEEPSEEK_MODEL=deepseek-chat

# Web application: see apps/web/.env.example. Vite reads apps/web/.env.local,
# not this repository-root example.
