root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,xml}]
indent_size = 4

[*.{ts,tsx,js,jsx,json,jsonc,css,scss,html,yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{cmd,bat,ps1}]
end_of_line = crlf
indent_size = 4

[mvnw]
end_of_line = lf
