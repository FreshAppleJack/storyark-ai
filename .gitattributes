# Normalize text files to LF in the repository and working tree by default.
* text=auto eol=lf

# Unix scripts
*.sh text eol=lf

# Windows scripts
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary -eol
*.jpg binary -eol
*.jpeg binary -eol
*.gif binary -eol
*.ico binary -eol
*.woff binary -eol
*.woff2 binary -eol
*.onnx filter=lfs diff=lfs merge=lfs -text
